from typing import Any

from flask.app import Flask

class _RecordsState:
    def __init__(self, app: Flask, entry_point_group: str | None = ...) -> None: ...
    def validate(self, data: dict[str, Any], schema: Any, **kwargs: Any) -> None: ...
    def replace_refs(self, data: Any) -> Any: ...

class InvenioRecords:
    def __init__(self, app: Flask | None = ..., **kwargs: Any) -> None: ...
    def init_app(
        self, app: Flask, entry_point_group: str = ..., **kwargs: Any,
    ) -> _RecordsState: ...
    def init_config(self, app: Flask) -> None: ...
