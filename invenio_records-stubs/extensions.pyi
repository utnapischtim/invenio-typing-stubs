from typing import Any


class ExtensionMixin[T]:
    def pre_init(
        self,
        record: T,
        data: dict[str, Any],
        model: Any | None = ...,
        **kwargs: Any,
    ) -> None: ...
    def post_init(
        self,
        record: T,
        data: dict[str, Any],
        model: Any | None = ...,
        **kwargs: Any,
    ) -> None: ...
    def pre_dump(
        self,
        record: T,
        data: dict[str, Any],
        dumper: Any | None = ...,
    ) -> None: ...
    def post_dump(
        self,
        record: T,
        data: dict[str, Any],
        dumper: Any | None = ...,
    ) -> None: ...
    def pre_load(self, data: dict[str, Any], loader: Any | None = ...) -> None: ...
    def post_load(
        self,
        record: T,
        data: dict[str, Any],
        loader: Any | None = ...,
    ) -> None: ...
    def pre_create(self, record: T) -> None: ...
    def post_create(self, record: T) -> None: ...
    def pre_commit(self, record: T) -> None: ...
    def post_commit(self, record: T) -> None: ...
    def pre_delete(self, record: T, force: bool = ...) -> None: ...
    def post_delete(self, record: T, force: bool = ...) -> None: ...
    def pre_revert(self, record: T, revision: Any) -> None: ...
    def post_revert(self, new_record: T, revision: Any) -> None: ...

class RecordExtension(ExtensionMixin): ...

class RecordMeta(type):
    def __new__(mcs, name: str, bases: tuple[type, ...], attrs: dict[str, Any]): ...
