from .request import DataCiteRequest


class DataCiteRESTClient:
    def __init__(
        self,
        username: str,
        password: str,
        prefix: str,
        test_mode: bool = False,
        url: str | None = None,
        timeout: str | None = None,
    ) -> None: ...
    def __repr__(self) -> str: ...
    def _create_request(self) -> DataCiteRequest: ...
    def doi_get(self, doi: str) -> str: ...
    def get_doi(self, doi: str) -> str: ...
    def check_doi(self, doi: str) -> str: ...
    def post_doi(self, data: dict) -> str: ...
    def put_doi(self, doi: str, data: dict) -> dict: ...
    def draft_doi(
        self,
        metadata: dict | None = None,
        doi: str | None = None,
    ) -> str: ...
    def update_url(self, doi: str, url: str) -> str: ...
    def delete_doi(self, doi: str) -> None: ...
    def public_doi(self, metadata: dict, url: str, doi: str | None = None) -> str: ...
    def update_doi(
        self,
        doi: str,
        metadata: dict | None = None,
        url: str | None = None,
    ) -> dict: ...
    def private_doi(self, metadata: dict, url: str, doi: str | None = None) -> str: ...
    def hide_doi(self, doi: str) -> dict: ...
    def show_doi(self, doi: str) -> dict: ...
    def metadata_get(self, doi: str) -> dict: ...
    def get_metadata(self, doi: str) -> dict: ...
    def media_get(self, doi: str) -> dict: ...
    def get_media(self, doi: str) -> dict: ...
