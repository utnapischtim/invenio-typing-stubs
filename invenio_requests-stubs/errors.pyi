
class ActionError(Exception):
    def __init__(self, action: str, reason: str) -> None: ...

class CannotExecuteActionError(ActionError):
    def __init__(self, action: str, reason: str | None = ...) -> None: ...

class NoSuchActionError(ActionError):
    def __init__(self, action: str, reason: str | None = ...) -> None: ...
