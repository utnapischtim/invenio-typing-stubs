from collections.abc import Callable, Iterator
from io import (
    BufferedReader,
    BytesIO,
)
from typing import (
    Any,
)
from uuid import UUID

from invenio_files_rest.models import (
    Bucket,
    ObjectVersion,
)
from invenio_records_resources.records.api import FileRecord, Record
from werkzeug.wsgi import LimitedStream

def ensure_enabled(func: Callable) -> Callable: ...

class FilesManager[R: Record = Record, F: FileRecord = FileRecord]:
    def __getitem__(self, key: str) -> F: ...
    def __init__(
        self,
        record: R,
        file_cls: type[F] | None = ...,
        bucket: None = ...,
        order: list[str] | None = ...,
        default_preview: str | None = ...,
        entries: dict[str, F] | None = ...,
        options: dict[str, Any] | None = ...,
        *,
        enabled: bool = ...,
    ) -> None: ...
    def __len__(self) -> int: ...
    def __setitem__(self, key: str, value: Any) -> None: ...
    def _parse_set_value(
        self,
        value: Any,
    ) -> tuple[Any, Any, dict[str, Any] | None]: ...
    @property
    def bucket(self) -> Bucket: ...
    @property
    def bucket_id(self) -> UUID: ...
    def set_quota(self, quota_size: int, max_file_size: int | None = ...): ...
    def lock(self): ...
    def unlock(self): ...
    def commit(self, file_key: str): ...
    def copy(self, src_files: FilesManager, copy_obj: bool = ...): ...
    @property
    def count(self) -> int: ...
    def create(
        self, key: str, *, obj=..., stream=..., data=..., transfer=..., **kwargs,
    ) -> F: ...
    def create_bucket(self): ...
    def create_obj(
        self,
        key: str,
        stream: BufferedReader | BytesIO | LimitedStream,
        data: dict[str, Any] | None = ...,
        **kwargs,
    ) -> ObjectVersion: ...
    def delete(
        self,
        key: str,
        remove_obj: bool = ...,
        softdelete_obj: bool = ...,
        remove_rf: bool = ...,
    ) -> F: ...
    def delete_all(
        self, remove_obj: bool = ..., softdelete_obj: bool = ..., remove_rf: bool = ...,
    ): ...
    @property
    def entries(self) -> dict[str, F]: ...
    @property
    def exts(self) -> list[Any]: ...
    @property
    def mimetypes(self) -> list[Any]: ...
    def remove_bucket(self, force: bool = ...): ...
    def unset_bucket(self): ...
    def set_bucket(self, bucket: Bucket, overwrite: bool = ...): ...
    def sync(self, src_files: FilesManager, delete_extras: bool = ...): ...
    def teardown(self, full: bool = ...): ...
    @property
    def total_bytes(self) -> int: ...
    def update(
        self,
        key: str,
        obj: ObjectVersion | None = ...,
        stream: BufferedReader | BytesIO | LimitedStream | None = ...,
        data: dict[str, Any] | None = ...,
        **kwargs,
    ) -> F: ...
    @property
    def enabled(self) -> bool: ...
    @enabled.setter
    def enabled(self, value: bool): ...
    @property
    def default_preview(self) -> str | None: ...
    @default_preview.setter
    def default_preview(self, key: str | None): ...
    @property
    def order(self) -> list[str]: ...
    @order.setter
    def order(self, new_order: list[str]): ...
    def __iter__(self) -> Iterator[str]: ...
    def __delitem__(self, key: str): ...
