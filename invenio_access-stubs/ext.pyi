from typing import Any

from flask import Flask
from flask_principal import Need
from werkzeug.utils import cached_property

from .permissions import SystemRoleNeed


class _AccessState:
    def __init__(
        self,
        app: Flask,
        entry_point_actions: str | None = None,
        entry_point_system_roles: str | None = None,
        cache: object | None = None,
    ) -> None: ...
    @cached_property
    def cache(self) -> object: ...
    def set_action_cache(self, action_key: str, data: str) -> str | None: ...
    def get_action_cache(self, action_key: str) -> str | None: ...
    def delete_action_cache(self, action_key: str) -> None: ...
    def register_action(self, action: Need) -> None: ...
    def load_entry_point_actions(self, entry_point_group: str) -> None: ...
    def register_system_role(self, system_role: SystemRoleNeed) -> None: ...
    def load_entry_point_system_roles(self, entry_point_group: str) -> None: ...

class InvenioAccess:
    def __init__(self, app: Flask, **kwargs: dict) -> None: ...
    def init_app(
        self,
        app: Flask,
        entry_point_actions: str,
        entry_point_system_roles: str,
        **kwargs: dict,
    ) -> None: ...
    def init_config(self, app: Flask) -> None: ...
    def __getattr__(self, name: str) -> Any | None: ...
