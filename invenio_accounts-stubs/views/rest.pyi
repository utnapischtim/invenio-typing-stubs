    def success_response(self) -> Response: ...
    def post(self, **kwargs: dict) -> Response: ...

class SendConfirmationEmailView(MethodView, UserViewMixin):
    decorators: ClassVar[list[Callable[..., Any]]]
    confirmation_link_func: Callable
