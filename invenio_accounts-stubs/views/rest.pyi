from ..modules import Role, User


def user_already_authenticated(f: Callable) -> Callable: ...
def role_to_dict(role: Role) -> dict[str, str]: ...
def create_rest_blueprint(app: Flask) -> Blueprint: ...

class FlaskParser(FlaskParserBase):
    @override
    def handle_error(  # type: ignore[override]
        self,
        error: Exception,
        *args: tuple,
        **kwargs: dict,
    ) -> None: ...

webargs_parser: FlaskParser

