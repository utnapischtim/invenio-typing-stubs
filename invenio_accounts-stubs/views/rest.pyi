class UserViewMixin:
    def get_user(self, email: str, **kwargs: dict) -> User: ...

class LoginView(MethodView, UserViewMixin):
    decorators: ClassVar[list[Callable[..., Any]]]
    post_args: dict

    def success_response(self, user: User) -> Response: ...
    def verify_login(
        self,
        user: User,
        password: str | None = None,
        **kwargs: dict,
    ) -> None: ...
    def login_user(self, user: User) -> bool: ...
    def post(self, **kwargs: dict) -> None: ...

class UserInfoView(MethodView):
    decorators: ClassVar[list[Callable[..., Any]]]

    def success_response(self, user: User) -> Response: ...
    def get(self) -> Response: ...

class LogoutView(MethodView):
    def logout_user_without_post_redirect(self) -> None: ...
    def success_response(self) -> Response: ...
    def post(self) -> Response: ...
    def get(self) -> Response: ...

class RegisterView(MethodView):
    decorators: ClassVar[list[Callable[..., Any]]]
    post_args: dict

    def login_user(self, user: User) -> None: ...
    def success_response(self, user: User) -> Response: ...
    def post(self, **kwargs: dict) -> Response: ...

class ForgotPasswordView(MethodView, UserViewMixin):
    decorators: ClassVar[list[Callable[..., Any]]]
    reset_password_link_func: Callable
    post_args: dict

    @classmethod
    def send_reset_password_instructions(cls, user: User) -> None: ...
    def success_response(self, user: User) -> Response: ...
    def post(self, **kwargs: dict) -> Response: ...

class ResetPasswordView(MethodView):
    decorators: ClassVar[list[Callable[..., Any]]]
    post_args: dict

    def get_user(self, token: str, **kwargs: dict) -> User: ...
    def success_response(self, user: User) -> Response: ...
    def post(self, **kwargs: dict) -> Response: ...

class ChangePasswordView(MethodView):
    decorators: ClassVar[list[Callable[..., Any]]]
    post_args: dict

    def verify_password(
        self,
