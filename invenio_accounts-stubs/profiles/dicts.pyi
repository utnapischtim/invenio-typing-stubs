from typing import Any

from .schemas import UserPreferencesSchema, UserProfileSchema


class ValidatedDict(dict):
    def __init__(
        self,
        schema: UserPreferencesSchema | UserProfileSchema,
        *args: tuple,
        **kwargs: dict,
    ) -> None: ...
    def _validate(self, data: dict) -> None: ...
    def _try_op(self, op_name: str, *args: tuple, **kwargs: dict) -> None: ...
    def clear(self) -> None: ...
    # def pop[T](self, key: str, default: T, /) -> Any | T: ... # problem with parent
    def popitem(self, *args: tuple, **kwargs: dict) -> Any: ...
    # def update(self, e: tuple, **f: dict) -> None: ... # problem with parent
    # def setdefault[T](self, key: str, default: T) -> T: ... # problem with parent
    def __setitem__[T](self, key: str, value: T) -> T: ...
    def __delitem__(self, key: str) -> Any: ...

class UserProfileDict(ValidatedDict):
    def __init__(self, **kwargs: dict) -> None: ...

class UserPreferenceDict(ValidatedDict):
    def __init__(self, **kwargs: dict) -> None: ...
