from flask_security import SQLAlchemyUserDatastore
from flask_sqlalchemy.models import Model

from .models import Domain, Role, User


class SessionAwareSQLAlchemyUserDatastore(SQLAlchemyUserDatastore):
    def verify_user(self, user: User) -> bool: ...
    def block_user(self, user: User) -> bool: ...
    def activate_user(self, user: User) -> bool: ...
    def deactivate_user(self, user: User) -> bool: ...
    def commit(self) -> None: ...
    def mark_changed(
        self,
        sid: str,
        uid: str | None = None,
        rid: str | None = None,
        model: Model | None = None,
    ) -> None: ...
    def update_role(self, role: Role) -> Role: ...
    def create_role(self, **kwargs: dict) -> Role: ...
    def find_role_by_id(self, role_id: str) -> Role: ...
    def find_domain(self, domain_or_id: str | Domain) -> Domain: ...
    def create_domain(self, domain: str, **kwargs: dict) -> Domain: ...
